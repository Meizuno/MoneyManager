// engineType "client": no Rust query engine in the process. Queries are
// compiled in JS/WASM and run over node-postgres (server/utils/db.ts hands
// the client a pg adapter). Measured under load, the Rust engine was most
// of the app's CPU — ~0.5 ms per query plus ~30 µs per row returned.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("NUXT_DATABASE_URL")
}

model Income {
  id           Int      @id @default(autoincrement())
  date         DateTime
  name         String
  amount       Decimal  @db.Decimal(10, 2)
  currency     String?
  category     Int      @default(0)
  user_id      String
  // The recurring transaction that wrote this one, or null for one written
  // by hand. Unique with the date: an occurrence is written once however
  // many times the job that writes it runs.
  recurring_id Int?
  created_at   DateTime @default(now())

  // Composite indexes matching the scoped queries: every read filters by
  // user_id first, then a date range (list/summary) or category id (the
  // in-use-on-delete guard). A user_id-prefixed index also covers plain
  // user_id lookups, so the old single-column indexes are redundant.
  @@index([user_id, date])
  @@index([user_id, category])
  @@unique([recurring_id, date])
  @@map("incomes")
}

model Expense {
  id           Int      @id @default(autoincrement())
  date         DateTime
  name         String
  amount       Decimal  @db.Decimal(10, 2)
  currency     String?
  category     Int      @default(0)
  user_id      String
  // The recurring transaction that wrote this one, or null for one written
  // by hand. Unique with the date: an occurrence is written once however
  // many times the job that writes it runs.
  recurring_id Int?
  created_at   DateTime @default(now())

  // See Income: composite (user_id, date) and (user_id, category) cover
  // the scoped list/summary and category-in-use queries respectively.
  @@index([user_id, date])
  @@index([user_id, category])
  @@unique([recurring_id, date])
  @@map("expenses")
}

model ExpenseCategory {
  id         Int      @id @default(autoincrement())
  user_id    String
  label      String
  percent    Decimal  @db.Decimal(5, 2)
  color      String
  position   Int      @default(0)
  // The one a new expense falls back to when it is created without a
  // category and nothing of the same name came before. At most one per
  // user — kept so by setDefault in server/utils/expense-categories.ts,
  // which clears the old one in the same transaction.
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("expense_categories")
}

model IncomeCategory {
  id         Int      @id @default(autoincrement())
  user_id    String
  label      String
  color      String
  position   Int      @default(0)
  // See ExpenseCategory.is_default — the same, for income.
  is_default Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([user_id])
  @@map("income_categories")
}

// A transaction that writes itself: one occurrence every `every` `unit`s
// (day, week, month, year) from `start_date`, until `end_date` if there is
// one. `next_date` is the next occurrence still to be written; the job in
// server/plugins/recurring.ts writes every one that has come due and moves
// it on (server/utils/recurring.ts). A monthly or yearly one keeps the day
// of `start_date`, falling back to the month's last day where it is short.
model RecurringTransaction {
  id         Int       @id @default(autoincrement())
  user_id    String
  type       String // 'income' | 'expense'
  name       String
  amount     Decimal   @db.Decimal(10, 2)
  currency   String?
  category   Int
  unit       String // 'day' | 'week' | 'month' | 'year'
  every      Int       @default(1)
  start_date DateTime
  end_date   DateTime?
  next_date  DateTime
  paused     Boolean   @default(false)
  created_at DateTime  @default(now())

  @@index([user_id])
  @@index([next_date])
  @@map("recurring_transactions")
}

// Scoped personal access tokens. Only the sha256 hash of the token is
// stored — the raw `mm_pat_…` value is shown to the user once at
// creation and never persisted. `scopes` holds the granted scope
// strings ('read' | 'add'); a JWT/session principal is full-access and
// has no row here.
model PersonalAccessToken {
  id           String    @id @default(cuid())
  user_id      String
  name         String
  token_hash   String    @unique
  scopes       String[]  @default([])
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  expires_at   DateTime?
  revoked_at   DateTime?

  @@index([user_id])
  @@map("personal_access_tokens")
}
